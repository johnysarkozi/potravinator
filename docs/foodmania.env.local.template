# ---------------------------------------------------------------------------
# foodmania-frontend  ->  copy to the repo root as `.env.local`
#
#   cp docs/foodmania.env.local.template <foodmania-frontend>/.env.local
#
# `.env.local` is gitignored in foodmania-frontend. Never commit it.
# ---------------------------------------------------------------------------

# --- REST API (production) --------------------------------------------------
# The live API client (src/framework/basic-rest/utils/endpoints.ts).
# Since 2026-09-22 production is foodmania.inovent.sk. backend.potravinator.cz
# still answers, but with the OLD data — do not use it.
NEXT_PUBLIC_REST_ENDPOINT=https://foodmania.inovent.sk

# The older, second axios instance (src/framework/basic-rest/utils/http.ts).
# Same host - keep both set or half the hooks silently hit a relative URL.
NEXT_PUBLIC_REST_API_ENDPOINT=https://foodmania.inovent.sk

# Basic-auth header injected by the endpoints.ts request interceptor.
# Leave EMPTY: the API needs no auth.
# (The www.potravinator.cz *frontend* vhost is behind nginx basic auth -
#  that is a different host and is not what the API client talks to.)
NEXT_PUBLIC_BASE_AUTH=

# --- Images / Thumbor CDN ---------------------------------------------------
NEXT_PUBLIC_CDN_BASE_URL=https://foodmania-img.inovent.sk

# Leave EMPTY: thumbor-client then emits /unsafe/... URLs, which this CDN
# accepts. Setting a wrong key produces signed URLs that 4xx on every image.
NEXT_PUBLIC_THUMBOR_SECURITY_KEY=

# --- Local site URL --------------------------------------------------------
# Only used to build share/canonical links, not for data fetching.
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000

# --- Optional third-party keys ---------------------------------------------
# Without these the app still runs; only these features degrade.
# Google Maps: the map / address picker renders blank.
NEXT_PUBLIC_GOOGLE_API_KEY=
# Stripe: the card checkout form does not mount.
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
